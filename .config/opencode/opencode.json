{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "OpenAgent",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "npm list*": "allow",
      "node -v*": "allow",
      "npm -v*": "allow",
      "which *": "allow",
      "pwd": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "echo *": "allow"
    },
    "edit": {
      "*": "ask",
      ".env*": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "formatter": {
    "prettier": {
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".json",
        ".json5",
        ".jsonc",
        ".css",
        ".scss",
        ".less",
        ".pcss",
        ".postcss",
        ".html",
        ".htm",
        ".md",
        ".mdx",
        ".markdown",
        ".yaml",
        ".yml",
        ".vue",
        ".graphql",
        ".gql",
        ".handlebars",
        ".hbs"
      ]
    },
    "custom-markdown-formatter": {
      "command": ["npx", "@franlol/opencode-md-table-formatter"],
      "extensions": [".md"]
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "timeout": 60000,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "mgrep": {
      "command": ["mgrep", "mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "opencode-claude-auth",
    "opencode-gemini-auth@latest",
    "@bastiangx/opencode-unmoji",
    "@nick-vi/opencode-type-inject@1.3.1",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@mohak34/opencode-notifier@latest"
  ],
  "provider": {
    "google": {
      "whitelist": [
        "gemini-2.5-flash",
        "gemini-2.5-pro",
        "gemini-3.5-flash",
        "gemini-3.1-pro-preview",
        "gemini-3.1-flash-lite"
      ],
      "options": {}
    },
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "deepseek/deepseek-v4-flash-free": {},
        "nvidia/nemotron-3-super-free": {}
      }
    }
  },
  "share": "auto",
  "snapshot": false,
  "username": "limaon",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      ".git/**",
      "coverage/**",
      ".cache/**",
      "out/**"
    ]
  }
}
