{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      ".git/**",
      "coverage/**",
      ".cache/**",
      "out/**"
    ]
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "timeout": 60000,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "mgrep": {
      "command": ["mgrep", "mcp"],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "edit": "ask",
    "write": "ask",
    "webfetch": "allow",
    "bash": {
      "ls *": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "*": "ask"
    }
  },
  "plugin": [
    // "opencode-claude-auth",
    "opencode-gemini-auth@latest",
    "@bastiangx/opencode-unmoji",
    "@nick-vi/opencode-type-inject@1.3.1",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@mohak34/opencode-notifier@latest"
  ],
  "provider": {
    "google": {
      "whitelist": [
        "gemini-2.5-flash",
        "gemini-2.5-pro",
        "gemini-3-flash-preview",
        "gemini-3-pro-preview"
      ]
    },
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "deepseek/deepseek-v4-flash-free": {},
        "nvidia/nemotron-3-super-free": {}
      }
    }
  },
  "snapshot": false,
  "theme": "solarized-osaka",
  "tui": {
    "diff_style": "auto",
    "scroll_acceleration": {
      "enabled": true
    },
    "scroll_speed": 5
  },
  "username": "limaon"
}
