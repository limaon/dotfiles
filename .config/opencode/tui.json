{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "solarized-osaka",
  "leader_timeout": 2000,
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "keybinds": {
    "leader": "ctrl+x",
    "app_exit": "none",
    "app_debug": "none",
    "app_console": "none",
    "app_heap_snapshot": "none",
    "app_toggle_animations": "none",
    "app_toggle_file_context": "none",
    "app_toggle_diffwrap": "none",
    "app_toggle_paste_summary": "none",
    "app_toggle_session_directory_filter": "none",
    "command_list": "none",
    "help_show": "none",
    "docs_open": "none",
    "editor_open": "none",
    "theme_list": "none",
    "theme_switch_mode": "none",
    "theme_mode_lock": "none",
    "sidebar_toggle": "none",
    "scrollbar_toggle": "none",
    "status_view": "none",
    "session_copy": "none",
    "session_move": "none",
    "session_new": "none",
    "session_list": "none",
    "session_fork": "none",
    "session_rename": "none",
    "session_delete": "ctrl+d",
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "escape",
    "session_compact": "none",
    "session_toggle_timestamps": "none",
    "session_toggle_generic_tool_output": "none",
    "session_child_first": "none",
    "session_child_cycle": "none",
    "session_child_cycle_reverse": "none",
    "session_parent": "up",
    "stash_delete": "ctrl+d",
    "model_provider_list": "none",
    "model_favorite_toggle": "none",
    "model_list": "none",
    "model_cycle_recent": "f2",
    "model_cycle_recent_reverse": "shift+f2",
    "model_cycle_favorite": "none",
    "model_cycle_favorite_reverse": "none",
    "mcp_list": "none",
    "provider_connect": "none",
    "console_org_switch": "none",
    "agent_list": "none",
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab",
    "variant_cycle": "ctrl+t",
    "variant_list": "none",
    "messages_page_up": "pageup",
    "messages_page_down": "pagedown",
    "messages_line_up": "none",
    "messages_line_down": "none",
    "messages_half_page_up": "none",
    "messages_half_page_down": "none",
    "messages_first": "home",
    "messages_last": "end",
    "messages_next": "none",
    "messages_previous": "none",
    "messages_last_user": "none",
    "messages_copy": "none",
    "messages_undo": "none",
    "messages_redo": "none",
    "messages_toggle_conceal": "none",
    "tool_details": "none",
    "display_thinking": "none",
    "prompt_submit": "none",
    "prompt_editor_context_clear": "none",
    "prompt_skills": "none",
    "prompt_stash": "none",
    "prompt_stash_pop": "none",
    "prompt_stash_list": "none",
    "workspace_set": "none",
    "input_clear": "ctrl+c",
    "input_paste": "ctrl+v",
    "input_submit": "return,ctrl+j",
    "input_newline": "none",
    "input_move_left": "left",
    "input_move_right": "right",
    "input_move_up": "up",
    "input_move_down": "down",
    "input_select_left": "shift+left",
    "input_select_right": "shift+right",
    "input_select_up": "shift+up",
    "input_select_down": "shift+down",
    "input_line_home": "none",
    "input_line_end": "none",
    "input_select_line_home": "none",
    "input_select_line_end": "none",
    "input_visual_line_home": "none",
    "input_visual_line_end": "none",
    "input_select_visual_line_home": "none",
    "input_select_visual_line_end": "none",
    "input_buffer_home": "home",
    "input_buffer_end": "end",
    "input_select_buffer_home": "shift+home",
    "input_select_buffer_end": "shift+end",
    "input_delete_line": "none",
    "input_delete_to_line_end": "none",
    "input_delete_to_line_start": "none",
    "input_backspace": "ctrl+h",
    "input_delete": "none",
    "input_undo": "none",
    "input_redo": "none",
    "input_word_forward": "alt+f",
    "input_word_backward": "alt+b",
    "input_select_word_forward": "none",
    "input_select_word_backward": "none",
    "input_delete_word_forward": "none",
    "input_delete_word_backward": "none",
    "input_select_all": "none",
    "history_previous": "ctrl+p",
    "history_next": "ctrl+n"
  },
  "attention": {
    "enabled": false,
    "notifications": false,
    "sound": false
  },
  "plugin": [
    [
      "@leohenon/opencode-vim-plugin@latest",
      {
        "enabled": true,
        "toggle_key": "ctrl+shift+v",
        "indicator": true,
        "vim_initial_mode": "normal",
        "vim_enter_submit": false,
        "vim_insert_after_submit": false,
        "vim_system_clipboard_register": true,
        "vim_normal_leader": "space",
        "normal_keybinds": {
          "j": "session.line.down",
          "k": "session.line.up",
          "ctrl+u": "messages_page_up",
          "ctrl+d": "messages_page_down",
          "<leader>n": "session_new",
          "<leader>l": "session_list",
          "<leader>r": "session_rename",
          "<leader>c": "session_compact",
          "<leader>e": "editor_open",
          "<leader>t": "theme_list",
          "<leader>b": "sidebar_toggle",
          "<leader>y": "messages_copy",
          "<leader>h": "messages_toggle_conceal",
          "<leader>a": "agent_list",
          "<leader>m": "model_list",
          "<leader>f": "session_fork",
          "<leader>s": "status_view",
          "<leader>q": "app_exit",
          "ctrl+r": "input_redo",
          "u": "input_undo"
        }
      }
    ]
  ]
}
