{
  "$schema": "https://opencode.ai/theme.json",

  "defs": {
    "base04": "#00141A",
    "base03": "#002D38",
    "base02": "#073541",
    "base01": "#586E74",
    "base00": "#647A82",

    "base0": "#9FABAD",
    "base1": "#ADB8B8",
    "base2": "#EDE7D4",
    "base3": "#FDF6E2",
    "base4": "#FFFFFF",

    "yellow": "#B28600",
    "orange": "#CA4C16",
    "red": "#DC312E",
    "magenta": "#D33682",
    "violet": "#6D72C5",
    "blue": "#278BD3",
    "cyan": "#2AA298",
    "green": "#859900",

    "greenDark": "#2C3300",
    "greenLight": "#EBFFD7",

    "redDark": "#57100F",
    "redLight": "#FFD2D1",

    "blueDark": "#103956",
    "blueLight": "#D7EEFF"
  },

  "theme": {
    "primary": {
      "dark": "blue",
      "light": "blue"
    },

    "secondary": {
      "dark": "violet",
      "light": "violet"
    },

    "accent": {
      "dark": "cyan",
      "light": "cyan"
    },

    "error": {
      "dark": "red",
      "light": "red"
    },

    "warning": {
      "dark": "yellow",
      "light": "yellow"
    },

    "success": {
      "dark": "green",
      "light": "green"
    },

    "info": {
      "dark": "blue",
      "light": "blue"
    },

    "text": {
      "dark": "base0",
      "light": "base01"
    },

    "textMuted": {
      "dark": "base01",
      "light": "base00"
    },

    "background": {
      "dark": "none",
      "light": "none"
    },

    "backgroundPanel": {
      "dark": "base04",
      "light": "base3"
    },

    "backgroundElement": {
      "dark": "base04",
      "light": "base2"
    },

    "border": {
      "dark": "base02",
      "light": "base1"
    },

    "borderActive": {
      "dark": "base01",
      "light": "base00"
    },

    "borderSubtle": {
      "dark": "base03",
      "light": "base2"
    },

    "diffAdded": {
      "dark": "green",
      "light": "green"
    },

    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },

    "diffContext": {
      "dark": "base01",
      "light": "base00"
    },

    "diffHunkHeader": {
      "dark": "blue",
      "light": "blue"
    },

    "diffHighlightAdded": {
      "dark": "green",
      "light": "green"
    },

    "diffHighlightRemoved": {
      "dark": "red",
      "light": "red"
    },

    "diffAddedBg": {
      "dark": "greenDark",
      "light": "greenLight"
    },

    "diffRemovedBg": {
      "dark": "redDark",
      "light": "redLight"
    },

    "diffContextBg": {
      "dark": "base04",
      "light": "base3"
    },

    "diffLineNumber": {
      "dark": "base01",
      "light": "base1"
    },

    "diffAddedLineNumberBg": {
      "dark": "greenDark",
      "light": "greenLight"
    },

    "diffRemovedLineNumberBg": {
      "dark": "redDark",
      "light": "redLight"
    },

    "markdownText": {
      "dark": "base0",
      "light": "base01"
    },

    "markdownHeading": {
      "dark": "blue",
      "light": "blue"
    },

    "markdownLink": {
      "dark": "blue",
      "light": "blue"
    },

    "markdownLinkText": {
      "dark": "cyan",
      "light": "cyan"
    },

    "markdownCode": {
      "dark": "cyan",
      "light": "cyan"
    },

    "markdownBlockQuote": {
      "dark": "base01",
      "light": "base00"
    },

    "markdownEmph": {
      "dark": "violet",
      "light": "violet"
    },

    "markdownStrong": {
      "dark": "yellow",
      "light": "yellow"
    },

    "markdownHorizontalRule": {
      "dark": "base02",
      "light": "base1"
    },

    "markdownListItem": {
      "dark": "yellow",
      "light": "yellow"
    },

    "markdownListEnumeration": {
      "dark": "orange",
      "light": "orange"
    },

    "markdownImage": {
      "dark": "magenta",
      "light": "magenta"
    },

    "markdownImageText": {
      "dark": "cyan",
      "light": "cyan"
    },

    "markdownCodeBlock": {
      "dark": "base0",
      "light": "base01"
    },

    "syntaxComment": {
      "dark": "base01",
      "light": "base1"
    },

    "syntaxKeyword": {
      "dark": "green",
      "light": "green"
    },

    "syntaxFunction": {
      "dark": "blue",
      "light": "blue"
    },

    "syntaxVariable": {
      "dark": "base0",
      "light": "base01"
    },

    "syntaxString": {
      "dark": "cyan",
      "light": "cyan"
    },

    "syntaxNumber": {
      "dark": "violet",
      "light": "violet"
    },

    "syntaxType": {
      "dark": "yellow",
      "light": "yellow"
    },

    "syntaxOperator": {
      "dark": "green",
      "light": "green"
    },

    "syntaxPunctuation": {
      "dark": "base0",
      "light": "base01"
    }
  }
}
