! vim: ft=xdefaults
! To make changes take effect, run xrdb -load $xresources_path
! Type xrdb -q to ensure the settings are loaded properly.
! It is possible to import colors using #include "/path/to/file"
! * If using gdm, edit the /etc/gdm/Xsession file and remove the -nocpp option
!   from the command that loads .Xresources ($userresources section)
! * If using GNOME on Wayland, uncomment the WaylandEnable=false in
!   /etc/gdm/custom.conf so that the resources will be loaded.

! Color Definitions {{{
! Color definitions for Solarized theme

#define base04        #001419
#define base03        #002d38
#define base02        #073541
#define base01        #586e74
#define base00        #647a82
#define base0         #9fabad
#define base1         #adb8b8
#define base2         #ede7d4
#define base3         #fdf6e2
#define base4         #ffffff
#define yellow        #b38600
#define orange        #ca4c16
#define red           #dc312e
#define magenta       #d33682
#define violet        #6d72c5
#define blue          #278bd3
#define cyan          #2aa298
#define green         #859900

! Bright colors (for color8-15)
#define bright_red      #f65351
#define bright_green    #b7fa00
#define bright_yellow   #ffbf00
#define bright_blue     #47adf5
#define bright_magenta  #f254a1
#define bright_cyan     #2beede
! }}}

! Terminal Colors {{{
! Terminal colors
*background:            base04
*foreground:            base0
*cursorColor:           base1

*.color0:                base02
*.color1:                red
*.color2:                green
*.color3:                yellow
*.color4:                blue
*.color5:                magenta
*.color6:                cyan
*.color7:                base2
*.color8:                base04
*.color9:                orange
*.color10:               base01
*.color11:               base00
*.color12:               base0
*.color13:               violet
*.color14:               base1
*.color15:               base3

*highlightColor:        base02
*highlightTextColor:    base04
*.selectionColor:       base01
*.barBackground:        white
*.mark.background:      yellow
*.bar.background: base01
*.bar.foreground: base04
! }}}

! Nsxiv Configuration {{{
! === Nsxiv ===
Nsxiv.window.background:        base04
Nsxiv.window.foreground:        base0
Nsxiv.bar.font:                 xos4 Terminus:pixelsize=20:antialias=true:autohint=true
Nsxiv.font:                     xos4 Terminus:pixelsize=20:antialias=true:autohint=true
Nsxiv.bar.background:           base01
Nsxiv.bar.foreground:           base04
Nsxiv.mark.foreground:    yellow
! }}}

! Cursor & Font Settings {{{
! Cursor settings
Xcursor.theme: Pop
Xcursor.size: 24


! Font settings
Xft.antialias:          1
Xft.autohint:           0
Xft.dpi:                96
Xft.hinting:            1
Xft.hintstyle:          hintslight
Xft.lcdfilter:          lcddefault
Xft.rgba:               none
! }}}

! Transparency & Fading {{{
!! Transparency (0-1):
*.alpha: 0.8
*.fading: 35
*.fadeColor: base04
! }}}

! XTerm/UXTerm Configuration {{{
! Colorscheme (XTerm/UXTerm)
?.vt100*background: base04
?.vt100*foreground: base0
?.vt100*cursorColor: base1
?.vt100*color0: base02
?.vt100*color1: red
?.vt100*color2: green
?.vt100*color3: yellow
?.vt100*color4: blue
?.vt100*color5: magenta
?.vt100*color6: cyan
?.vt100*color7: base2
?.vt100*color8: base04
?.vt100*color9: orange
?.vt100*color10: base01
?.vt100*color11: base00
?.vt100*color12: base0
?.vt100*color13: violet
?.vt100*color14: base1
?.vt100*color15: base3
! }}}

! XTerm Settings {{{
! XTerm settings
xterm*faceName: xft:UbuntuMono:size=16:antialias=true
xterm*faceNameBold: xft:UbuntuMono:bold:style=Bold:size=15:antialias=true
xterm*faceNameDoublesize: Noto Sans CJK
xterm*allowBold: true
xterm*renderFont: true
xterm*loginShell: true
?.vt100.termName: xterm-256color
?.vt100.locale: false
?.vt100.utf8: true
?.vt100.bellIsUrgent: true
?.vt100*geometry: 130x50
?.vt100.colorMode: on
?.scaleHeight: 1.01
?.internalBorder: 15
?.*cursorBlink: true
?.*cursorOnTime: 600
?.*cursorOffTime: 600

! Every shell is a login shell by default (for inclusion of all necessary environment variables)
?.vt100.loginshell: true

! Typeface
?.vt100.faceName: xft:UbuntuMono:size=15:antialias=true
?.vt100.faceNameBold: xft:UbuntuMono:bold:style=Bold:size=15:antialias=true
?.vt100.faceNameDoublesize: Noto Sans CJK
?.vt100*allow_bold: true
?.vt100.renderFont: true
?.vt100.colorBDMode: true
?.vt100.colorBD: rgb:82/a4/d3
?.vt100.colorULMode: true
?.vt100.colorUL: rgb:e4/e4/e4
?.*boldMode: false
! }}}

! Scrollbar Configuration {{{
! Scrollbar
?.vt100.scrollBar: false
?.*mouseWheelScrollPage: true
?.vt100.saveLines: 16384
?.*rightScrollBar: true
?.vt100.scrollbar.width: 6
?.*scrollBarTtyOutput: false
?.*scrollTtyKeypress: true
?.letterSpace: 0
! }}}

! URL & Keyboard Configuration {{{
! Double-click to select whole URLs
?.charClass: 33:48,35:48,37:48,43:48,45-47:48,64:48,95:48,126:48
! }}}

! Alt Keys & Input {{{
! Make alt keys
?.vt100.metaSendsEscape: true
?.vt100.backarrowKey: false
?.ttyModes: erase ^?
?.*eightBitInput: false
?.*eightBitOutput:  true
! }}}

! Terminal Transparency {{{
! terminal transparent setup
?.*transparent: true
?.*opacity: 0.8
! }}}

! Copy-Paste Configuration {{{
! Copy-paste
?.vt100.selectToClipboard: true
?.vt100*translations: #override \
        Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
        Ctrl Shift <Key>V: insert-selection(CLIPBOARD) \n\
        Ctrl <Key> minus: smaller-vt-font() \n\
        Ctrl <Key> plus: larger-vt-font() \n\
        Ctrl <Key> 0: set-vt-font(d)
! }}}

! st - Simple Terminal {{{
! === st - Simple Terminal (Solarized Osaka - Official Colors) ===
! Font configuration
st.font: JetBrainsMono Nerd Font Mono:pixelsize=18:antialias=true:autohint=true
st.borderpx: 2

! Solarized Osaka Color Scheme (Official)
! Base colors
st.foreground: base0
st.background: base04
st.cursorColor: green

! Black (base04, base03)
st.color0: base04
st.color8: base03

! Red
st.color1: red
st.color9: bright_red

! Green
st.color2: green
st.color10: bright_green

! Yellow
st.color3: yellow
st.color11: bright_yellow

! Blue
st.color4: blue
st.color12: bright_blue

! Magenta
st.color5: magenta
st.color13: bright_magenta

! Cyan
st.color6: cyan
st.color14: bright_cyan

! White (base2, base3)
st.color7: base2
st.color15: base3

! Transparency
st.alpha: 0.8

! Cursor
st.cursorshape: 2
st.cursorthickness: 2

! Bell
st.bellvolume: 0
! }}}
