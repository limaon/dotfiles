! vim: ft=xdefaults
! To make changes take effect, run xrdb -load $xresources_path
! Type xrdb -q to ensure the settings are loaded properly.
! It is possible to import colors using #include "/path/to/file"
! * If using gdm, edit the /etc/gdm/Xsession file and remove the -nocpp option
!   from the command that loads .Xresources ($userresources section)
! * If using GNOME on Wayland, uncomment the WaylandEnable=false in
!   /etc/gdm/custom.conf so that the resources will be loaded.

! Color Definitions {{{
! Color definitions for Solarized theme

#define base04        #001419
#define base03        #002d38
#define base02        #073541
#define base01        #586e74
#define base00        #647a82
#define base0         #9fabad
#define base1         #adb8b8
#define base2         #ede7d4
#define base3         #fdf6e2
#define base4         #ffffff
#define yellow        #b38600
#define orange        #ca4c16
#define red           #dc312e
#define magenta       #d33682
#define violet        #6d72c5
#define blue          #278bd3
#define cyan          #2aa298
#define green         #859900

! Bright colors (for color8-15)
#define bright_black    #586e74
#define bright_red      #d94a48
#define bright_green    #a6d500
#define bright_yellow   #e0a800
#define bright_blue     #3c9fe0
#define bright_magenta  #d04a91
#define bright_cyan     #26c8bb
#define bright_white    #f4efd9
! }}}

! Terminal Colors {{{
! Terminal colors
*background:            base04
*foreground:            base0
*cursorColor:           base1

*.color0:                base02
*.color1:                red
*.color2:                green
*.color3:                yellow
*.color4:                blue
*.color5:                magenta
*.color6:                cyan
*.color7:                base2
*.color8:                base04
*.color9:                orange
*.color10:               base01
*.color11:               base00
*.color12:               base0
*.color13:               violet
*.color14:               base1
*.color15:               base3

*highlightColor:        base02
*highlightTextColor:    base04
*.selectionColor:       base01
*.barBackground:        white
*.mark.background:      yellow
*.bar.background: base01
*.bar.foreground: base04
! }}}

! Nsxiv Configuration {{{
! === Nsxiv ===
Nsxiv.window.background:        base04
Nsxiv.window.foreground:        base0
Nsxiv.bar.font:                 xos4 Terminus:pixelsize=20:antialias=true:autohint=true
Nsxiv.font:                     xos4 Terminus:pixelsize=20:antialias=true:autohint=true
Nsxiv.bar.background:           base01
Nsxiv.bar.foreground:           base04
Nsxiv.mark.foreground:    yellow
! }}}

! Cursor & Font Settings {{{
! Cursor settings
Xcursor.theme: Pop
Xcursor.size: 24


! Font settings
Xft.antialias:          1
Xft.autohint:           0
Xft.dpi:                96
Xft.hinting:            1
Xft.hintstyle:          hintslight
Xft.lcdfilter:          lcddefault
Xft.rgba:               none
! }}}

! Transparency is managed by the X11 compositor.

! URxvt Configuration {{{
! This section contains urxvt/urxterm-specific resources.

! Appearance, UTF-8 and terminal identity
URxvt*font: xft:UbuntuMono Nerd Font Mono:size=15:style=Regular:antialias=true
URxvt*boldFont: xft:UbuntuMono Nerd Font Mono:size=15:style=Bold:antialias=true
URxvt*termName: rxvt-unicode-256color
URxvt*depth: 32
URxvt*internalBorder: 12
URxvt*geometry: 130x50

! Colors
URxvt*foreground: base0
! ARGB background: 85% opaque, interpreted by the X11 compositor.
URxvt*background: [85]base04
URxvt*cursorColor: base1
URxvt*color0: base02
URxvt*color1: red
URxvt*color2: green
URxvt*color3: yellow
URxvt*color4: blue
URxvt*color5: magenta
URxvt*color6: cyan
URxvt*color7: base2
URxvt*color8: bright_black
URxvt*color9: bright_red
URxvt*color10: bright_green
URxvt*color11: bright_yellow
URxvt*color12: bright_blue
URxvt*color13: bright_magenta
URxvt*color14: bright_cyan
URxvt*color15: bright_white

! Selection, scrolling and cursor
URxvt*highlightColor: base02
URxvt*highlightTextColor: base04
URxvt*saveLines: 16384
URxvt*scrollBar: false
URxvt*cursorBlink: true
URxvt*cursorUnderline: false
! }}}

! XTerm Configuration {{{
! This section contains only XTerm/UXTerm resources.

! Appearance, UTF-8 and terminal identity
*.vt100.faceName: UbuntuMono Nerd Font Mono:size=15:style=Regular:antialias=true
*.vt100.boldFont: UbuntuMono Nerd Font Mono:size=15:style=Bold:antialias=true
*.vt100.faceNameDoublesize: Noto Sans CJK
*.vt100.renderFont: true
*.vt100.allowBoldFonts: true
*.vt100.boldMode: false
*.vt100.locale: false
*.vt100.utf8: true
*.vt100.scaleHeight: 1.02
*.vt100.internalBorder: 12
*.vt100.geometry: 130x50

! Application-level terminal identity (XTerm and UXTerm both use these).
XTerm*termName: xterm-256color
UXTerm*termName: xterm-256color

! Color attributes
*.vt100.foreground: base0
*.vt100.background: base04
*.vt100.cursorColor: base1
*.vt100.colorMode: true
*.vt100.dynamicColors: false

! ANSI colors 0-7
*.vt100.color0: base02
*.vt100.color1: red
*.vt100.color2: green
*.vt100.color3: yellow
*.vt100.color4: blue
*.vt100.color5: magenta
*.vt100.color6: cyan
*.vt100.color7: base2

! ANSI bright colors 8-15
*.vt100.color8: bright_black
*.vt100.color9: bright_red
*.vt100.color10: bright_green
*.vt100.color11: bright_yellow
*.vt100.color12: bright_blue
*.vt100.color13: bright_magenta
*.vt100.color14: bright_cyan
*.vt100.color15: bright_white

! Text attribute colors
! Keep bold ANSI colors (90-97) instead of forcing one color on all bold text.
*.vt100.colorBDMode: false
*.vt100.colorULMode: true
*.vt100.colorUL: blue
*.vt100.colorRVMode: true
*.vt100.colorRV: red

! Selection colors
*.vt100.highlightColor: base02
*.vt100.highlightTextColor: base04
*.vt100.highlightColorMode: true

! Cursor, scrolling and bell
*.vt100.cursorBlink: true
*.vt100.cursorOnTime: 600
*.vt100.cursorOffTime: 600
*.vt100.cursorBar: true
*.vt100.saveLines: 16384
*.vt100.scrollBar: false
*.vt100.jumpScroll: true
*.vt100.scrollKey: true
*.vt100.scrollTtyOutput: false
*.vt100.mouseWheelScrollPage: true
*.vt100.bellIsUrgent: true

! Keyboard and selection
*.vt100.metaSendsEscape: true
*.vt100.backarrowKey: false
*.ttyModes: erase ^?
*.vt100.eightBitInput: false
*.vt100.eightBitOutput: true
*.vt100.charClass: 33:48,35:48,37:48,43:48,45-47:48,64:48,95:48,126:48
*.vt100.selectToClipboard: true

! Ctrl+Shift+C/V match common terminal behavior.
*.vt100.translations: #override \
        Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
        Ctrl Shift <Key>V: insert-selection(CLIPBOARD) \n\
        Ctrl <Key>minus: smaller-vt-font() \n\
        Ctrl <Key>plus: larger-vt-font() \n\
        Ctrl <Key>0: set-vt-font(d)

! OSC 52 enables clipboard integration with tmux and SSH.
*.disallowedWindowOps: 20,21,SetXprop
! }}}

! st - Simple Terminal {{{
! === st - Simple Terminal (Solarized Osaka - Official Colors) ===
! Font configuration
st.font: JetBrainsMono Nerd Font Mono:pixelsize=18:antialias=true:autohint=true
st.borderpx: 2

! Solarized Osaka Color Scheme (Official)
! Base colors
st.foreground: base0
st.background: base04
st.cursorColor: green

! Black (base04, base03)
st.color0: base04
st.color8: base03

! Red
st.color1: red
st.color9: bright_red

! Green
st.color2: green
st.color10: bright_green

! Yellow
st.color3: yellow
st.color11: bright_yellow

! Blue
st.color4: blue
st.color12: bright_blue

! Magenta
st.color5: magenta
st.color13: bright_magenta

! Cyan
st.color6: cyan
st.color14: bright_cyan

! White (base2, base3)
st.color7: base2
st.color15: base3

! Transparency
st.alpha: 0.8

! Cursor
st.cursorshape: 2
st.cursorthickness: 2

! Bell
st.bellvolume: 0
! }}}
