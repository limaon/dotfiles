{
  "Shebang bash": {
    "prefix": "shebang",
    "body": ["#!/usr/bin/env bash", "", "set -euo pipefail"],
    "description": "Bash shebang with safe options"
  },
  "Shebang sh": {
    "prefix": "shebang-sh",
    "body": ["#!/usr/bin/env sh", ""],
    "description": "Basic sh shebang"
  },
  "Local variable": {
    "prefix": "local",
    "body": ["local $0=\"\""],
    "description": "Local variable"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "$0() {",
      "  local arg1=\"$1\"",
      "  ",
      "}"
    ],
    "description": "Function definition"
  },
  "If statement": {
    "prefix": "if",
    "body": ["if [ $0 ]; then", "  ", "fi"],
    "description": "If block"
  },
  "If-else": {
    "prefix": "ife",
    "body": ["if [ $0 ]; then", "  ", "else", "  ", "fi"],
    "description": "If-else block"
  },
  "If-elif-else": {
    "prefix": "ifelif",
    "body": [
      "if [ $0 ]; then",
      "  ",
      "elif [  ]; then",
      "  ",
      "else",
      "  ",
      "fi"
    ],
    "description": "If-elif-else block"
  },
  "For loop (file)": {
    "prefix": "for",
    "body": ["for $0 in *; do", "  ", "done"],
    "description": "For loop over files"
  },
  "For loop (seq)": {
    "prefix": "forseq",
    "body": ["for ((i=$0; i<10; i++)); do", "  ", "done"],
    "description": "For loop with numeric sequence"
  },
  "For loop (command)": {
    "prefix": "forin",
    "body": ["for $0 in $(ls); do", "  ", "done"],
    "description": "Basic shell for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while [ $0 ]; do", "  ", "done"],
    "description": "While loop"
  },
  "Case statement": {
    "prefix": "case",
    "body": [
      "case \"$0\" in",
      "  pattern1)",
      "    ",
      "    ;;",
      "  pattern2)",
      "    ",
      "    ;;",
      "  *)",
      "    ",
      "    ;;",
      "esac"
    ],
    "description": "Case block"
  },
  "Test equal": {
    "prefix": "ifeq",
    "body": ["[ \"$0\" = \"\" ]"],
    "description": "Equality test"
  },
  "Test file exists": {
    "prefix": "iff",
    "body": ["[ -f \"$0\" ]"],
    "description": "Test if file exists"
  },
  "Test directory exists": {
    "prefix": "ifd",
    "body": ["[ -d \"$0\" ]"],
    "description": "Test if directory exists"
  },
  "Test empty string": {
    "prefix": "ifz",
    "body": ["[ -z \"$0\" ]"],
    "description": "Test if string is empty"
  },
  "Read input": {
    "prefix": "read",
    "body": ["read -r -p \"$0: \" var_name"],
    "description": "Read user input"
  },
  "Echo with color": {
    "prefix": "echo",
    "body": ["echo -e \"\\033[$0mmsg\\033[0m\""],
    "description": "Echo with ANSI color"
  },
  "Redirect output": {
    "prefix": "redirect",
    "body": ["$0 2>&1 | tee output.log"],
    "description": "Redirect stdout and stderr"
  },
  "Trap signal": {
    "prefix": "trap",
    "body": ["trap '$0' EXIT INT TERM"],
    "description": "Trap for cleanup signals"
  },
  "Array": {
    "prefix": "array",
    "body": ["local $0=(element1 element2 element3)"],
    "description": "Declare array"
  },
  "Array loop": {
    "prefix": "foreach",
    "body": [
      "for $0 in \"${arr[@]}\"; do",
      "  ",
      "done"
    ],
    "description": "Loop over array"
  },
  "Simple getopts": {
    "prefix": "getopts",
    "body": [
      "while getopts \"$0\" opt; do",
      "  case $opt in",
      "    v)",
      "      ",
      "      ;;",
      "    h)",
      "      ",
      "      ;;",
      "    *)",
      "      echo \"Usage: $0 [options]\" 1>&2",
      "      exit 1",
      "      ;;",
      "  esac",
      "done"
    ],
    "description": "Basic getopts for arguments"
  },
  "Check root": {
    "prefix": "ifroot",
    "body": [
      "if [ \"$EUID\" -ne 0 ]; then",
      "  echo \"Please run as root\"",
      "  exit 1",
      "fi"
    ],
    "description": "Check if running as root"
  },
  "Backup file": {
    "prefix": "backup",
    "body": ["cp -v \"$0\" \"$0.$(date +%Y%m%d_%H%M%S).bak\""],
    "description": "Create file backup"
  },
  "Mkdir with exists check": {
    "prefix": "mkdir",
    "body": ["mkdir -p \"$0\""],
    "description": "Create directory if not exists"
  },
  "Log function": {
    "prefix": "log",
    "body": [
      "log() {",
      "  echo \"[$(date +'%Y-%m-%d %H:%M:%S')] $0\"",
      "  echo \"[$(date +'%Y-%m-%d %H:%M:%S')] $0\" >> \"logfile\"",
      "}"
    ],
    "description": "Log function"
  },
  "Error function": {
    "prefix": "error",
    "body": [
      "error() {",
      "  echo \"ERROR: $0\" >&2",
      "  exit 1",
      "}"
    ],
    "description": "Error function"
  }
}
