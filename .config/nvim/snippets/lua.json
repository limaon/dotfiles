{
  "function": {
    "prefix": "func",
    "body": ["function $0", "\t", "end"],
    "description": "Function definition"
  },
  "local function": {
    "prefix": "lfunc",
    "body": ["local function $0", "\t", "end"],
    "description": "Local function definition"
  },
  "if statement": {
    "prefix": "if",
    "body": ["if $0 then", "\t", "end"],
    "description": "If statement"
  },
  "elseif": {
    "prefix": "elseif",
    "body": ["elseif $0 then", "\t"],
    "description": "Elseif clause"
  },
  "for loop": {
    "prefix": "for",
    "body": ["for $0 = 1, 10 do", "\t", "end"],
    "description": "For loop"
  },
  "while loop": {
    "prefix": "while",
    "body": ["while $0 do", "\t", "end"],
    "description": "While loop"
  },
  "require": {
    "prefix": "req",
    "body": "local $0 = require('')",
    "description": "Require module"
  },
  "print": {
    "prefix": "print",
    "body": "print($0)",
    "description": "Print statement"
  }
}
