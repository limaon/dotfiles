{
  "flexbox": {
    "prefix": "flex",
    "body": [
      "display: flex;",
      "justify-content: $0;",
      "align-items: center;"
    ],
    "description": "Flexbox properties"
  },
  "grid": {
    "prefix": "grid",
    "body": [
      "display: grid;",
      "grid-template-columns: $0;",
      "gap: 10px;"
    ],
    "description": "CSS Grid"
  },
  "media query": {
    "prefix": "media",
    "body": ["@media (max-width: $0) {", "\t", "}"],
    "description": "Media query"
  },
  "keyframes": {
    "prefix": "keyframes",
    "body": [
      "@keyframes $0 {",
      "\tfrom {",
      "\t\t",
      "\t}",
      "\tto {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "Keyframes animation"
  },
  "transition": {
    "prefix": "transition",
    "body": "transition: $0;",
    "description": "CSS transition"
  },
  "border-radius": {
    "prefix": "border-radius",
    "body": "border-radius: $0;",
    "description": "Border radius"
  },
  "box-shadow": {
    "prefix": "box-shadow",
    "body": "box-shadow: $0;",
    "description": "Box shadow"
  },
  "center": {
    "prefix": "center",
    "body": [
      "position: absolute;",
      "top: 50%;",
      "left: 50%;",
      "transform: translate(-50%, -50%);"
    ],
    "description": "Center element absolutely"
  }
}
