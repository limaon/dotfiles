#!/usr/bin/env bash
#
# lf preview script - Text-only edition
# Shows text previews for all file types
#
# No caching, no images, no external dependencies beyond standard tools
#

filetype="$(file -Lb --mime-type -- "$1")"
encoding="$(file --mime-encoding -Lb -- "$1" 2>/dev/null)"

# -- Text files with syntax highlighting --------------------------------

preview_text() {
  if command -v bat &>/dev/null; then
    bat --color=always --style=numbers --wrap=auto \
        --terminal-width="$(( $2 - 2 ))" -- "$1" 2>/dev/null || cat -n -- "$1"
  else
    cat -n -- "$1"
  fi
}

# -- Archives -----------------------------------------------------------

preview_tar()   { tar tf "$1" | head -n 30; }
preview_gzip()  { tar -ztf "$1" | head -n 30; }
preview_bzip2() { tar -jtf "$1" | head -n 30; }
preview_xz()    { tar -Jtf "$1" | head -n 30; }
preview_zip()   { unzip -l "$1" | head -n 30; }
preview_rar()   { unrar l "$1" | head -n 30; }
preview_7z()    { 7z l "$1" 2>/dev/null | tail -n +9 | head -n 30; }
preview_zstd()  { tar --use-compress-program=zstd -tf "$1" | head -n 30; }

# -- Structured formats -------------------------------------------------

preview_pdf() {
  if command -v pdftotext &>/dev/null; then
    pdftotext "$1" - | head -n 50
  else
    echo "[pdftotext not installed]"
  fi
}

preview_office() {
  if command -v docx2txt &>/dev/null && [[ "$1" == *.docx ]]; then
    docx2txt "$1" - | head -n 50
  elif command -v xlsx2csv &>/dev/null && [[ "$1" == *.xlsx ]]; then
    xlsx2csv "$1" | head -n 30
  elif command -v catdoc &>/dev/null && [[ "$1" == *.doc ]]; then
    catdoc "$1" | head -n 50
  else
    echo "[office preview unavailable]"
  fi
}

preview_iso() {
  if command -v iso-info &>/dev/null; then
    iso-info --no-header -l "$1" | head -n 30
  else
    echo "[iso-info not installed]"
  fi
}

# -- Video metadata ------------------------------------------------------

preview_video() {
  if command -v ffprobe &>/dev/null; then
    ffprobe -v quiet -of json -show_format -show_streams -- "$1" | python3 -c "
import sys, json
data = json.load(sys.stdin)
fmt = data.get('format', {})
tags = fmt.get('tags', {})

print('File     :', fmt.get('filename', '').split('/')[-1])

for k in ('title', 'artist', 'album', 'date', 'genre', 'description'):
    v = tags.get(k) or tags.get(k.upper())
    if v: print(f'{k.capitalize():<12}: {v}')

dur = float(fmt.get('duration', 0))
if dur:
    m, s = divmod(int(dur), 60)
    h, m = divmod(m, 60)
    print('Duration     :', f'{h}:{m:02}:{s:02}' if h else f'{m}:{s:02}')

size = fmt.get('size')
if size: print('Size         :', f'{int(size)/1024/1024:.1f} MiB')

video_shown = False
audio_shown = False
for st in data.get('streams', []):
    if st.get('codec_type') == 'video' and not video_shown:
        codec = st.get('codec_name', '?')
        w = st.get('width', '?')
        h = st.get('height', '?')
        fps = st.get('avg_frame_rate', '?')
        br = st.get('bit_rate')
        print(f'Video        : {codec}  {w}x{h}  {fps} fps')
        if br: print(f'Video BR     : {int(br)//1000} kbps')
        video_shown = True
    elif st.get('codec_type') == 'audio' and not audio_shown:
        codec = st.get('codec_name', '?')
        sr = st.get('sample_rate', '?')
        ch = st.get('channels', '?')
        br = st.get('bit_rate')
        print(f'Audio        : {codec}  {sr} Hz  {ch}ch')
        if br: print(f'Audio BR     : {int(br)//1000} kbps')
        audio_shown = True
"
  else
    echo "[ffprobe not installed]"
  fi
}

# -- Audio metadata -----------------------------------------------------

preview_audio() {
  if command -v ffprobe &>/dev/null; then
    ffprobe -v quiet -of json -show_format -show_streams -- "$1" | python3 -c "
import sys, json
data = json.load(sys.stdin)
fmt = data.get('format', {})
tags = fmt.get('tags', {})

print('File     :', fmt.get('filename', '').split('/')[-1])

for k in ('title', 'artist', 'album', 'date', 'genre', 'description'):
    v = tags.get(k) or tags.get(k.upper())
    if v: print(f'{k.capitalize():<12}: {v}')

dur = float(fmt.get('duration', 0))
if dur:
    m, s = divmod(int(dur), 60)
    h, m = divmod(m, 60)
    print('Duration     :', f'{h}:{m:02}:{s:02}' if h else f'{m}:{s:02}')

br = fmt.get('bit_rate')
if br: print('Bitrate      :', f'{int(br)//1000} kbps')

size = fmt.get('size')
if size: print('Size         :', f'{int(size)/1024/1024:.1f} MiB')

for st in data.get('streams', []):
    if st.get('codec_type') == 'audio':
        codec = st.get('codec_name', '?')
        sr = st.get('sample_rate', '?')
        ch = st.get('channels', '?')
        print(f'Codec        : {codec}  {sr} Hz  {ch}ch')
        break
"
  else
    echo "[ffprobe not installed]"
  fi
}

# -- Torrent metadata ---------------------------------------------------

preview_torrent() {
  if command -v transmission-show &>/dev/null; then
    transmission-show "$1" | head -n 30
  elif command -v aria2c &>/dev/null; then
    aria2c -S "$1" | head -n 30
  else
    python3 - "$1" << 'PY'
import sys, os, datetime
import bencodepy
with open(sys.argv[1], 'rb') as fp:
    meta = bencodepy.decode(fp.read())
info = meta[b'info']
name = info[b'name'].decode()
size = sum(f[b'length'] for f in info.get(b'files', [info]))
creation = meta.get(b'creation date', 0)
print(f"Name       : {name}")
print(f"Size       : {size/2**20:.2f} MiB")
print(f"Pieces     : {len(info[b'pieces'])//20}")
print(f"Created    : {datetime.datetime.utcfromtimestamp(creation)}")
print("Trackers   :")
for t in meta.get(b'announce-list', [[meta.get(b'announce', b'')]]):
    print("  *", t[0].decode())
if b'files' in info:
    print("Files      :")
    for f in info[b'files'][:10]:
        print("  +-", os.path.join(*(p.decode() for p in f[b'path'])))
PY
  fi
}

# -- Font metadata ------------------------------------------------------

preview_font() {
  if command -v fc-query &>/dev/null; then
    fc-query -f "%{family}\n%{fullname}\n%{style}\n%{weight}\n" "$1"
  else
    echo "[font preview unavailable]"
  fi
}

# -- File metadata (fallback for binaries) ------------------------------

preview_binary() {
  printf "File     : %s\n" "$(basename -- "$1")"
  printf "Type     : %s\n" "$(file -Lb -- "$1" 2>/dev/null)"
  printf "MIME     : %s\n" "$filetype"
  printf "Size     : %s\n" "$(du -sh -- "$1" 2>/dev/null | cut -f1)"
  printf "Modified : %s\n" "$(date -r "$1" '+%d/%m/%Y %H:%M:%S' 2>/dev/null)"
  printf "Perms    : %s\n" "$(stat -c '%A %U:%G' -- "$1" 2>/dev/null)"
}

# -- Main dispatcher (lf passes geometry as $2-$5) ----------------------

case "$filetype" in
  # Text files
  text/*)
    preview_text "$@"
    ;;

  # Archives
  application/x-tar|application/tar|application/gtar|application/x-gtar)
    preview_tar "$1"
    ;;
  application/gzip|application/x-gzip)
    preview_gzip "$1"
    ;;
  application/bzip2|application/x-bzip2)
    preview_bzip2 "$1"
    ;;
  application/x-xz)
    preview_xz "$1"
    ;;
  application/zip)
    preview_zip "$1"
    ;;
  application/x-rar|application/rar)
    preview_rar "$1"
    ;;
  application/x-7z-compressed)
    preview_7z "$1"
    ;;
  application/zstd|application/x-zstd)
    preview_zstd "$1"
    ;;

  # Documents
  application/pdf|application/postscript)
    preview_pdf "$1"
    ;;
  */*office*|*/*document*|*/*wordprocessingml*|*/*spreadsheetml*|*/*presentationml*|\
  application/msword|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.ms-*)
    preview_office "$1"
    ;;

  # Media
  video/*)
    preview_video "$1"
    ;;
  audio/*)
    preview_audio "$1"
    ;;

  # Other formats
  application/x-iso9660-image)
    preview_iso "$1"
    ;;
  application/x-bittorrent)
    preview_torrent "$1"
    ;;
  application/font-*|font/*)
    preview_font "$1"
    ;;

  # Binary fallback
  *)
    if [[ "$encoding" == us-ascii || "$encoding" == utf-* || "$encoding" == iso-8859-* ]]; then
      preview_text "$@"
    else
      preview_binary "$1"
    fi
    ;;
esac
