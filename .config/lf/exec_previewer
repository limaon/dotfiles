#!/usr/bin/env bash

set -u
set -o pipefail

command_exists() {
  command -v "$1" &>/dev/null
}

unavailable() {
  printf '[%s]\n' "$1"
}

preview_head() {
  local lines="$1"
  shift

  "$@" | head -n "$lines"
  local command_status="${PIPESTATUS[0]}"

  [[ "$command_status" -eq 0 || "$command_status" -eq 141 ]]
}

# Arguments provided by lf's previewer interface.
file_path="${1:?missing file path}"
preview_width="${2:-80}"
preview_height="${3:-24}"
preview_x="${4:-0}"
preview_y="${5:-0}"
preview_mode="${6:-preview}"

#
# lf preview script
# Shows previews for text, media, archives, and images
#
# External tools are checked before use
#

filetype="$(file -Lb --mime-type -- "$file_path")"
encoding="$(file --mime-encoding -Lb -- "$file_path" 2>/dev/null)"

# -- Text files with syntax highlighting --------------------------------

preview_text() {
  local file="$1"
  local width="${2:-80}"
  width=$((width > 4 ? width - 2 : 2))

  if command_exists bat; then
    bat --color=always --style=numbers --wrap=auto \
        --terminal-width="$width" -- "$file" 2>/dev/null || cat -n -- "$file"
  else
    cat -n -- "$file"
  fi
}

# -- Images --------------------------------------------------------------

preview_image() {
  local file="$1"
  local width="${2:-80}"
  local height="${3:-24}"
  local x="${4:-0}"
  local y="${5:-0}"

  if ! command_exists kitty; then
    unavailable 'kitty not installed'
  elif [[ "${TERM:-}" != xterm-kitty && -z "${KITTY_WINDOW_ID:-}" ]]; then
    unavailable 'Kitty graphics protocol unavailable'
  else
    kitty +kitten icat \
      --stdin=no \
      --transfer-mode=file \
      --place "${width}x${height}@${x}x${y}" \
      -- "$file" \
      < /dev/null > /dev/tty

    # Image placement is an external side effect; do not cache it in lf.
    exit 1
  fi
}

# -- Archives ------------------------------------------------------------

preview_archive() {
  local file="$1"
  local mime_type="$2"

  case "$mime_type" in
    application/x-tar|application/tar|application/gtar|application/x-gtar)
      preview_head 30 tar -tf "$file"
      ;;
    application/gzip|application/x-gzip)
      preview_head 30 tar -ztf "$file"
      ;;
    application/bzip2|application/x-bzip2)
      preview_head 30 tar -jtf "$file"
      ;;
    application/x-xz)
      preview_head 30 tar -Jtf "$file"
      ;;
    application/zip)
      preview_head 30 unzip -l -- "$file"
      ;;
    application/x-rar|application/rar)
      preview_head 30 unrar l -- "$file"
      ;;
    application/x-7z-compressed)
      7z l -- "$file" 2>/dev/null | tail -n +9 | head -n 30
      local statuses=("${PIPESTATUS[@]}")
      [[ "${statuses[0]}" -eq 0 || "${statuses[0]}" -eq 141 ]] &&
        [[ "${statuses[1]}" -eq 0 || "${statuses[1]}" -eq 141 ]]
      ;;
    application/zstd|application/x-zstd)
      preview_head 30 tar --use-compress-program=zstd -tf "$file"
      ;;
  esac
}

# -- Structured formats -------------------------------------------------

preview_pdf() {
  local file="$1"

  if command_exists pdftotext; then
    preview_head 50 pdftotext "$file" -
  else
    unavailable 'pdftotext not installed'
  fi
}

preview_office() {
  local file="$1"

  if command_exists docx2txt && [[ "$file" == *.docx ]]; then
    preview_head 50 docx2txt "$file" -
  elif command_exists xlsx2csv && [[ "$file" == *.xlsx ]]; then
    preview_head 30 xlsx2csv "$file"
  elif command_exists catdoc && [[ "$file" == *.doc ]]; then
    preview_head 50 catdoc "$file"
  else
    unavailable 'office preview unavailable'
  fi
}

preview_iso() {
  local file="$1"

  if command_exists iso-info; then
    preview_head 30 iso-info --no-header -l "$file"
  else
    unavailable 'iso-info not installed'
  fi
}

preview_media_metadata() {
  local file="$1"
  local media_type="$2"

  if ! command_exists ffprobe; then
    unavailable 'ffprobe not installed'
  elif ! command_exists jq; then
    unavailable 'jq not installed'
  else
    ffprobe -v quiet -of json -show_format -show_streams -- "$file" |
      jq -r --arg media_type "$media_type" '
        .format as $format |
        ($format.tags // {}) as $tags |
        ([.streams[]? | select(.codec_type == "video")][0]) as $video |
        ([.streams[]? | select(.codec_type == "audio")][0]) as $audio |

        "File     : \($format.filename // "unknown" | split("/")[-1])",

        (["title", "artist", "album", "date", "genre", "description"][] |
          . as $key |
          ($tags[$key] // $tags[($key | ascii_upcase)]) as $value |
          select($value != null and $value != "") |
          (((($key[0:1] | ascii_upcase) + $key[1:]) + "            ")[0:12]) as $label |
          "\($label): \($value)"
        ),

        (if $format.duration then
          ($format.duration | tonumber | floor) as $total_seconds |
          ($total_seconds / 60 | floor) as $total_minutes |
          ($total_minutes / 60 | floor) as $hours |
          ($total_minutes % 60) as $minutes |
          ($total_seconds % 60) as $seconds |
          ("0" + ($minutes | tostring))[-2:] as $minutes_padded |
          ("0" + ($seconds | tostring))[-2:] as $seconds_padded |
          "Duration     : " +
            (if $hours > 0 then
              "\($hours):\($minutes_padded):\($seconds_padded)"
             else
              "\($total_minutes):\($seconds_padded)"
             end)
         else empty end),

        (if $format.size then
          (($format.size | tonumber / 1024 / 1024) * 10 | floor) as $size_tenths |
          "Size         : \($size_tenths / 10)\(if ($size_tenths % 10) == 0 then ".0" else "" end) MiB"
         else empty end),

        (if $media_type == "video" and $video != null then
          "Video        : \($video.codec_name // "?")  \($video.width // "?")x\($video.height // "?")  \($video.avg_frame_rate // "?") fps",
          (if $video.bit_rate then
            "Video BR     : \($video.bit_rate | tonumber / 1000 | floor) kbps"
           else empty end)
         else empty end),

        (if $audio != null then
          (if $media_type == "video" then "Audio" else "Codec" end) as $label |
          "\($label)        : \($audio.codec_name // "?")  \($audio.sample_rate // "?") Hz \($audio.channels // "?")ch",
          (if $media_type == "video" and $audio.bit_rate then
            "Audio BR     : \($audio.bit_rate | tonumber / 1000 | floor) kbps"
           else empty end)
         else empty end)
      '
  fi
}

preview_video_metadata() {
  local file="$1"
  preview_media_metadata "$file" video
}

preview_audio() {
  local file="$1"
  preview_media_metadata "$file" audio
}

preview_video() {
  local file="$1"
  local width="${2:-80}"
  local height="${3:-24}"
  local x="${4:-0}"
  local y="${5:-0}"
  local thumbnail

  if ! command_exists ffmpeg; then
    preview_video_metadata "$file"
    return
  fi

  if ! command_exists kitty || \
    [[ "${TERM:-}" != xterm-kitty && -z "${KITTY_WINDOW_ID:-}" ]]; then
    preview_video_metadata "$file"
    return
  fi

  thumbnail="$(mktemp --suffix=.jpg)"
  trap 'rm -f -- "$thumbnail"' EXIT

  if ! ffmpeg -hide_banner -loglevel error \
    -i "$file" \
    -frames:v 1 \
    -q:v 2 \
    -y "$thumbnail"; then
    preview_video_metadata "$file"
    return
  fi

  kitty +kitten icat \
    --stdin=no \
    --transfer-mode=file \
    --place "${width}x${height}@${x}x${y}" \
    -- "$thumbnail" \
    < /dev/null > /dev/tty

  # Image placement is an external side effect; do not cache it in lf.
  exit 1
}

# -- Torrent metadata ---------------------------------------------------

preview_torrent() {
  local file="$1"

  if command_exists transmission-show; then
    preview_head 30 transmission-show "$file"
  elif command_exists aria2c; then
    preview_head 30 aria2c -S "$file"
  else
    unavailable 'transmission-show or aria2c not installed'
  fi
}

# -- Font metadata ------------------------------------------------------

preview_font() {
  local file="$1"

  if command_exists fc-query; then
    fc-query -f "%{family}\n%{fullname}\n%{style}\n%{weight}\n" "$file"
  else
    unavailable 'font preview unavailable'
  fi
}

# -- File metadata (fallback for binaries) ------------------------------

preview_binary() {
  local file="$1"

  printf "File     : %s\n" "$(basename -- "$file")"
  printf "Type     : %s\n" "$(file -Lb -- "$file" 2>/dev/null)"
  printf "MIME     : %s\n" "$filetype"
  printf "Size     : %s\n" "$(du -sh -- "$file" 2>/dev/null | cut -f1)"
  printf "Modified : %s\n" "$(date -r "$file" '+%d/%m/%Y %H:%M:%S' 2>/dev/null)"
  printf "Perms    : %s\n" "$(stat -c '%A %U:%G' -- "$file" 2>/dev/null)"
}

# -- Preview dispatcher --------------------------------------------------

dispatch_preview() {
  case "$filetype" in
  # Images
  image/*)
    [[ "$preview_mode" == preload ]] && return 1
    preview_image "$file_path" "$preview_width" "$preview_height" "$preview_x" "$preview_y"
    ;;

  # Text files
  text/*)
    preview_text "$file_path" "$preview_width"
    ;;

  # Archives
  application/x-tar|application/tar|application/gtar|application/x-gtar|\
  application/gzip|application/x-gzip|application/bzip2|application/x-bzip2|\
  application/x-xz|application/zip|application/x-rar|application/rar|\
  application/x-7z-compressed|application/zstd|application/x-zstd)
    preview_archive "$file_path" "$filetype"
    ;;

  # Documents
  application/pdf|application/postscript)
    preview_pdf "$file_path"
    ;;
  */*office*|*/*document*|*/*wordprocessingml*|*/*spreadsheetml*|*/*presentationml*|\
  application/msword|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.ms-*)
    preview_office "$file_path"
    ;;

  # Media
  video/*)
    [[ "$preview_mode" == preload ]] && return 1
    preview_video "$file_path" "$preview_width" "$preview_height" "$preview_x" "$preview_y"
    ;;
  audio/*)
    preview_audio "$file_path"
    ;;

  # Other formats
  application/x-iso9660-image)
    preview_iso "$file_path"
    ;;
  application/x-bittorrent)
    preview_torrent "$file_path"
    ;;
  application/font-*|font/*)
    preview_font "$file_path"
    ;;

  # Binary fallback
  *)
    if [[ "$encoding" == us-ascii || "$encoding" == utf-* || "$encoding" == iso-8859-* ]]; then
      preview_text "$file_path" "$preview_width"
    else
      preview_binary "$file_path"
    fi
    ;;
  esac
}

dispatch_preview
