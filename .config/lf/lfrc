#: === SYSTEM OPERATIONS === {{{

#: Stop lf (suspend)
cmd stop ${{
  kill -TSTP "$(ps -p $$ -o 'ppid=')"
}}

#: Unmount USB devices
cmd ud-unmount ${{
    if udiskie-umount -aef; then
        lf -remote "send $id echomsg >> The device was umounted <<"
    else
        lf -remote "send $id echoerr >> udiskie-umount failed <<"
    fi
}}

#: Open mounted removable devices
cmd removable-devices ${{
  mount_root="/run/media/$(id -un)"
  mounted_device="$(find "$mount_root" -mindepth 1 -maxdepth 1 -type d \
    -exec mountpoint -q -- {} \; -print -quit 2>/dev/null)"

  if [ -n "$mounted_device" ]; then
    lf -remote "send $id cd \"$mount_root\""
  else
    lf -remote "send $id echoerr 'No removable device mounted'"
  fi
}}

#: Set background image
cmd setbg ${{
  case "$(file --mime-type -Lb "$f")" in
    image/*)  setsid -f setbg "$f" >/dev/null 2>&1 ;;
    *)        lf -remote "send $id echoerr 'not an image'" ;;
  esac
}}

#: Select files by glob pattern
cmd select-glob &{{
    select_glob() {
        files="$(printf '%s\0' "$@" | sed 's/ /\\ /g;s/\x00/ /g')"
        lf -remote "send $id :unselect; toggle $files"
    }

    [ "$#" -eq 1 ] || exit

    # enable recursive glob and failglob
    shopt -s globstar failglob

    select_glob $1
}}

