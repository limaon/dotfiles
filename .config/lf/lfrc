# vim: ts=2 sts=2 sw=2 ft=conf foldmethod=marker

#: ============================================================================
#: LF CONFIGURATION - Lima's Setup
#: ============================================================================
#: Fast terminal file manager with vim-like keybindings.
#: Organized by sections for easy navigation and customization.
#: ============================================================================

#: === CORE SETTINGS === {{{

set shell bash
set shellopts '-eu'
set ifs "\n"

#: }}}

#: === DISPLAY & APPEARANCE === {{{

set info size
set sortby natural
set noreverse
set dircounts
set period 1
set autoquit true
set ratios 3:2
set scrolloff 5
set drawbox
set icons
set ignorecase
set incfilter
set incsearch
set tabstop 2
set wrapscroll
set truncatechar ">"

#: }}}

#: === EXTERNAL TOOLS & FORMATTERS === {{{

set cleaner "~/.config/lf/exec_cleaner"
set previewer "~/.config/lf/exec_previewer"
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"

#: }}}

#: === TIME & COLOR FORMATTING === {{{

set timefmt "02/01/2006 15:04:05 "
set infotimefmtnew '02/01 15:04'
set infotimefmtold '02/01/06'
set errorfmt "\033[1;31m"
set numberfmt "\033[38;2;75;87;116m"
set rulerfile "~/.config/lf/rulerfile"
set cursorpreviewfmt "\033[7m"

#: }}}

#: === COMMANDS & FUNCTIONS === {{{

#: Configuration reload
cmd cfg_reload source ~/.config/lf/lfrc

#: File opening with MIME type detection
cmd open ${{
  image_files=()
  video_files=()

  for f in $fx; do
    # 0 discard qBittorrent temporary files
    [[ "$f" == *'.!qB' ]] && continue

    # 1 guard: skip empty files (0 byte)
    if [ ! -s "$f" ]; then
      lf -remote "send $id echo 'Empty file ignored: ${f##*/}'"
      continue
    fi

    # 2 guard: malformed PDFs
    ext="${f##*.}"
    if [[ "${ext,,}" = pdf ]]; then
      if head -c4 -- "$f" | grep -q $'%PDF'; then
        setsid -f zathura "$f" >/dev/null 2>&1 &
      else
        lf -remote "send $id echo 'Damaged PDF: ${f##*/} - please re-download the file'"
      fi
      continue
    fi

    # 3 MIME detection with mimeapps.list
    mime=$(file --mime-type -Lb -- "$f")

    # Open all selected images in one nsxiv instance.
    if [[ "$mime" == image/* ]]; then
      image_files+=("$f")
      continue
    fi

    # Open all selected videos in one mpv playlist.
    if [[ "$mime" == video/* ]]; then
      video_files+=("$f")
      continue
    fi

    mimeapps="$HOME/.config/mimeapps.list"
    app=""

    if [ -f "$mimeapps" ]; then
      app=$(grep "^${mime}=" "$mimeapps" | head -1 | sed 's/^[^=]*=//' | sed 's/;.*//')
    fi

    # Open with app from mimeapps or fallback to xdg-open
    if [ -n "$app" ]; then
      setsid -f xdg-open "$f" >/dev/null 2>&1 &
    else
      setsid -f "${OPENER:-xdg-open}" "$f" >/dev/null 2>&1 &
    fi
  done

  if ((${#image_files[@]})); then
    if command -v nsxiv >/dev/null 2>&1; then
      setsid -f nsxiv -- "${image_files[@]}" >/dev/null 2>&1 &
    else
      for f in "${image_files[@]}"; do
        setsid -f "${OPENER:-xdg-open}" "$f" >/dev/null 2>&1 &
      done
    fi
  fi

  if ((${#video_files[@]})); then
    if command -v mpv >/dev/null 2>&1; then
      setsid -f mpv -- "${video_files[@]}" >/dev/null 2>&1 &
    else
      for f in "${video_files[@]}"; do
        setsid -f "${OPENER:-xdg-open}" "$f" >/dev/null 2>&1 &
      done
    fi
  fi
}}

#: Directory change hook
cmd on-cd %{{
  case "$(basename -- "$PWD")" in
    Downloads|Screenshots)
      lf -remote "send $id set sortby time"
      lf -remote "send $id set reverse"
      ;;
    *)
      lf -remote "send $id set sortby natural"
      lf -remote "send $id set noreverse"
      ;;
  esac
}}

# Update the bottom ruler with metadata for the selected video
cmd on-select &{{
  clear_file_metadata() {
    lf -remote "send $id set user_file_meta ''"
  }

  set_file_metadata() {
    escaped_metadata="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    lf -remote "send $id set user_file_meta '$escaped_metadata'"
  }

  archive_entry_count() {
    case "$1" in
      application/zip)
        zipinfo -1 -- "$2" 2>/dev/null | wc -l
        ;;
      application/x-tar|application/tar|application/gtar|application/x-gtar|\
      application/gzip|application/x-gzip|application/bzip2|application/x-bzip2|\
      application/x-xz|application/zstd|application/x-zstd)
        tar -tf -- "$2" 2>/dev/null | wc -l
        ;;
      application/x-7z-compressed)
        7z l -slt -- "$2" 2>/dev/null |
          awk -F ' = ' '$1 == "Path" {count++} END {print count + 0}'
        ;;
      application/x-rar|application/rar)
        unrar lb -- "$2" 2>/dev/null | wc -l
        ;;
      *)
        printf '0\n'
        ;;
    esac
  }

  mime="$(file --mime-type -Lb -- "$f" 2>/dev/null)"

  case "$mime" in
    image/*)
      if ! command -v identify &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      metadata="$(identify -format '%wx%h · %m · %[colorspace] · %z-bit\n' \
        -- "$f" 2>/dev/null | head -n 1)"
      capture_date="$(identify -format '%[EXIF:DateTimeOriginal]' \
        -- "$f" 2>/dev/null | head -n 1)"
      camera="$(identify -format '%[EXIF:Make] %[EXIF:Model]' \
        -- "$f" 2>/dev/null | sed 's/[[:space:]]\+/ /g' | sed 's/^ *//;s/ *$//' | head -n 1)"
      [ -n "$capture_date" ] && metadata="$metadata · $capture_date"
      [ -n "$camera" ] && metadata="$metadata · $camera"
      set_file_metadata "$metadata"
      ;;
    application/zip|application/x-tar|application/tar|application/gtar|\
    application/x-gtar|application/gzip|application/x-gzip|application/bzip2|\
    application/x-bzip2|application/x-xz|application/zstd|application/x-zstd|\
    application/x-7z-compressed|application/x-rar|application/rar)
      entries="$(archive_entry_count "$mime" "$f")"
      set_file_metadata "ARCHIVE · $entries entries"
      ;;
    application/epub+zip|application/x-mobipocket-ebook|application/vnd.amazon.ebook)
      if ! command -v ebook-meta &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      metadata="$(ebook-meta "$f" 2>/dev/null | awk -F': ' \
        '$1 == "Title" || $1 == "Author(s)" {values[++count] = $2} \
         END {for (i = 1; i <= count; i++) printf "%s%s", (i > 1 ? " · " : ""), values[i]}')"
      set_file_metadata "EBOOK · $metadata"
      ;;
    audio/*)
      if ! command -v ffprobe &>/dev/null || ! command -v jq &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      metadata="$(
        ffprobe -v quiet -of json -show_format -show_streams -- "$f" |
          jq -r '
            .format as $format |
            ([.streams[]? | select(.codec_type == "audio")][0]) as $audio |
            ($format.duration // "0" | tonumber | floor) as $seconds_total |
            ($seconds_total / 60 | floor) as $minutes |
            ($seconds_total % 60) as $seconds |
            ("0" + ($seconds | tostring))[-2:] as $seconds_padded |
            [
              (if $audio.codec_name then ($audio.codec_name | ascii_upcase) else empty end),
              (if $seconds_total > 0 then "\($minutes):\($seconds_padded)" else empty end),
              (if $audio.bit_rate then "\($audio.bit_rate | tonumber / 1000 | floor) kbps" else empty end),
              (if $audio.sample_rate then "\($audio.sample_rate | tonumber / 1000) kHz" else empty end),
              (if $audio.channels then "\($audio.channels)ch" else empty end)
            ] | join(" · ")
          ' || true
      )"
      set_file_metadata "$metadata"
      ;;
    application/pdf)
      if ! command -v pdfinfo &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      pages="$(pdfinfo -- "$f" 2>/dev/null | awk '$1 == "Pages:" {print $2}')"
      page_size="$(pdfinfo -- "$f" 2>/dev/null | awk '$1 == "Page" && $2 == "size:" {print $3 "x" $5}')"
      metadata="PDF · ${pages:-?} páginas"
      [ -n "$page_size" ] && metadata="$metadata · $page_size pt"
      set_file_metadata "$metadata"
      ;;
    application/font-*|font/*)
      if ! command -v fc-query &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      metadata="$(fc-query -f '%{family} · %{style}\n' "$f" 2>/dev/null | head -n 1)"
      set_file_metadata "$metadata"
      ;;
    video/*)
      if ! command -v ffprobe &>/dev/null || ! command -v jq &>/dev/null; then
        clear_file_metadata
        exit 0
      fi

      metadata="$(
        ffprobe -v quiet -of json -show_format -show_streams -- "$f" |
          jq -r '
            .format as $format |
            ([.streams[]? | select(.codec_type == "video")][0]) as $video |
            ($format.duration // "0" | tonumber | floor) as $seconds_total |
            ($seconds_total / 60 | floor) as $minutes_total |
            ($minutes_total / 60 | floor) as $hours |
            ($minutes_total % 60) as $minutes |
            ($seconds_total % 60) as $seconds |
            ("0" + ($minutes | tostring))[-2:] as $minutes_padded |
            ("0" + ($seconds | tostring))[-2:] as $seconds_padded |
            [
              (if $video then
                "\($video.width // "?")x\($video.height // "?")"
               else empty end),
              (if $video.codec_name then $video.codec_name else empty end),
              (if $seconds_total > 0 then
                (if $hours > 0 then
                  "\($hours):\($minutes_padded):\($seconds_padded)"
                 else
                  "\($minutes_total):\($seconds_padded)"
                 end)
               else empty end)
            ] | join(" · ")
          ' || true
      )"

      set_file_metadata "$metadata"
      ;;
    *)
      clear_file_metadata
      ;;
  esac
}}

