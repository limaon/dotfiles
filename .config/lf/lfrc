# vim: ts=2 sts=2 sw=2 ft=conf foldmethod=marker

#: ============================================================================
#: LF CONFIGURATION - Lima's Setup
#: ============================================================================
#: Fast terminal file manager with vim-like keybindings.
#: Organized by sections for easy navigation and customization.
#: ============================================================================

#: === CORE SETTINGS === {{{

set shell bash
set shellopts '-eu'
set ifs "\n"

#: }}}

#: === DISPLAY & APPEARANCE === {{{

set info size
set sortby natural
set noreverse
set dircounts
set period 1
set autoquit true
set ratios 3:2
set scrolloff 5
set drawbox
set icons
set ignorecase
set incfilter
set incsearch
set tabstop 2
set wrapscroll
set truncatechar ">"

#: }}}

#: === EXTERNAL TOOLS & FORMATTERS === {{{

set cleaner "~/.config/lf/exec_cleaner"
set previewer "~/.config/lf/exec_previewer"
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"

#: }}}

#: === TIME & COLOR FORMATTING === {{{

set timefmt "02/01/2006 15:04:05 "
set infotimefmtnew '02/01 15:04'
set infotimefmtold '02/01/06'
set errorfmt "\033[1;31m"
set numberfmt "\033[38;2;75;87;116m"
set rulerfile "~/.config/lf/rulerfile"
set cursorpreviewfmt "\033[7m"

#: }}}

#: === COMMANDS & FUNCTIONS === {{{

#: Configuration reload
cmd cfg_reload source ~/.config/lf/lfrc

#: File opening with MIME type detection
cmd open ${{
  for f in $fx; do
    # 0 discard qBittorrent temporary files
    [[ "$f" == *'.!qB' ]] && continue

    # 1 guard: skip empty files (0 byte)
    if [ ! -s "$f" ]; then
      lf -remote "send $id echo 'Empty file ignored: ${f##*/}'"
      continue
    fi

    # 2 guard: malformed PDFs
    ext="${f##*.}"
    if [[ "${ext,,}" = pdf ]]; then
      if head -c4 -- "$f" | grep -q $'%PDF'; then
        setsid -f zathura "$f" >/dev/null 2>&1 &
      else
        lf -remote "send $id echo 'Damaged PDF: ${f##*/} - please re-download the file'"
      fi
      continue
    fi

    # 3 MIME detection with mimeapps.list
    mime=$(file --mime-type -Lb -- "$f")
    mimeapps="$HOME/.config/mimeapps.list"
    app=""

    if [ -f "$mimeapps" ]; then
      app=$(grep "^${mime}=" "$mimeapps" | head -1 | sed 's/^[^=]*=//' | sed 's/;.*//')
    fi

    # Open with app from mimeapps or fallback to xdg-open
    if [ -n "$app" ]; then
      setsid -f xdg-open "$f" >/dev/null 2>&1 &
    else
      setsid -f "${OPENER:-xdg-open}" "$f" >/dev/null 2>&1 &
    fi
  done
}}

#: Directory change hook
cmd on-cd %{{
  case "$(basename -- "$PWD")" in
    Downloads|Screenshots)
      lf -remote "send $id set sortby time"
      lf -remote "send $id set reverse"
      ;;
    *)
      lf -remote "send $id set sortby natural"
      lf -remote "send $id set noreverse"
      ;;
  esac
}}

#: }}}

#: === NAVIGATION COMMANDS === {{{

#: Jump to directory with fzf
cmd changedirectory ${{
  set -f
  MBASE="/run/media/$(id -un)"
  clear; tput cup $(($(tput lines)/3)); tput bold
  printf 'Go to where?\n'

  dirpath="$(find "$HOME" "$MBASE" -maxdepth 4 -type d 2>/dev/null \
              | fzf --layout=reverse --height 40% --prompt 'Go to where? ')"

  [[ -n "$dirpath" ]] && lf -remote "send $id cd \"$dirpath\""
}}

#: Jump to current playing song in MPD
cmd go_to_current_song ${{
	music_dir=$( grep -Po 'music_directory\s*"\K.*(?="$)' ~/.config/mpd/mpd.conf )
	playing_file=$( mpc -f %file% | head -1 )
	lf -remote " send $id select '${music_dir}/${playing_file}' "
}}

#: }}}

#: === CACHE & RELOAD COMMANDS === {{{

#: Hard reload (clear cache)
cmd hard-reload &{{
  if [ -d "$HOME/.cache/lf" ]; then
    find "$HOME/.cache/lf" -mindepth 1 -delete 2>/dev/null
    rmdir -- "$HOME/.cache/lf" 2>/dev/null || true
  fi
  lf -remote "send $id reload"
}}

#: Cancel ongoing file transfer
cmd cancel-transfer &{{
  pid_file="$HOME/.cache/lf/transfer.pid"
  if [ ! -f "$pid_file" ]; then
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  pid=$(cat "$pid_file" 2>/dev/null)
  if [ -z "$pid" ]; then
    rm -f -- "$pid_file"
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f -- "$pid_file"
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  kill -TERM "$pid" 2>/dev/null
  sleep 0.3
  kill -KILL "$pid" 2>/dev/null || true

  rm -f -- "$pid_file"

  notify-send -u critical "Transfer cancelled" \
    "Operation was cancelled by user. Partial files may remain at destination." \
    2>/dev/null
  lf -remote "send $id echoerr 'transfer: cancelled by user'"
  lf -remote "send $id reload"
}}

#: }}}

#: === CLIPBOARD OPERATIONS === {{{

#: Yank file path, name, or directory
cmd yank &{{
  case ${1} in
    dir)  dirname "${f}" ;;
    name) basename "${f}" ;;
    path) printf "%s" "${f}" ;;
  esac | xclip -rmlastnl -selection clipboard
}}

#: }}}

#: === FILE TRANSFER OPERATIONS === {{{

#: Paste files (copy or move)
cmd paste ${{
  FILES_DB="$HOME/.local/share/lf/files"
  [ -f "$FILES_DB" ] || exit 1

  mode="$(head -n 1 -- "$FILES_DB")"
  mapfile -t items < <(tail -n +2 -- "$FILES_DB")
  [ "${#items[@]}" -gt 0 ] || exit 0

  case "$mode" in
    copy)
      rsync -av --progress -- "${items[@]}" . && \
        notify-send -i edit-copy "Copied" "$(printf '%s\n' "${items[@]}" | wc -l) file(s)" 2>/dev/null
      ;;
    move)
      rsync -av --progress --remove-source-files -- "${items[@]}" . && \
        notify-send -i edit-cut "Moved" "$(printf '%s\n' "${items[@]}" | wc -l) file(s)" 2>/dev/null
      ;;
  esac

  rm -f -- "$FILES_DB"
  lf -remote 'send reload'
}}

#: Copy to destination
cmd copyto ${{
  set -f
  dest="$(find "$HOME" /run/media -maxdepth 4 -type d 2>/dev/null | fzf --prompt 'Copy to: ')"
  [ -d "$dest" ] || exit 1
  rsync -av --progress -- $fx "$dest" 2>/dev/null && \
    notify-send -i edit-copy "Copied" "to $dest" 2>/dev/null
  lf -remote 'send reload'
}}

#: Move to destination
cmd moveto ${{
  set -f
  dest="$(find "$HOME" /run/media -maxdepth 4 -type d 2>/dev/null | fzf --prompt 'Move to: ')"
  [ -d "$dest" ] || exit 1
  rsync -av --progress --remove-source-files -- $fx "$dest" 2>/dev/null && \
    notify-send -i edit-cut "Moved" "to $dest" 2>/dev/null
  lf -remote 'send reload'
}}

#: }}}

#: === DELETE & TRASH OPERATIONS === {{{

#: Permanently delete files
cmd delete ${{
  set -f
  clear
  printf '%s\n' $fx | xargs -I {} basename {}
  echo "Delete these file(s)? [y/N]"
  read -r ans
  if [ "$ans" = "y" ]; then
    rm -rf -- $fx
    lf -remote 'send reload'
  fi
}}

#: Move to trash
cmd trash ${{
  set -f
  for x in $fx; do
    gio trash "$x"
  done
  lf -remote 'send reload'
}}

#: Clear trash
cmd clear_trash %gio trash --empty

#: Restore from trash
cmd restore_trash ${{
  gio trash --restore -- "trash:///$(basename -- "$f")"
}}

#: }}}

#: === ARCHIVE OPERATIONS === {{{

#: Extract archives (simple)
cmd extract ${{
  set -f
  for x in $fx; do
    case "$x" in
      *.tar.gz|*.tgz)   tar -xzf "$x" ;;
      *.tar.bz2|*.tbz2) tar -xjf "$x" ;;
      *.tar.xz|*.txz)   tar -xJf "$x" ;;
      *.tar)            tar -xf "$x" ;;
      *.zip)            unzip -q "$x" ;;
      *.rar)            urar x "$x" ;;
      *.7z)             7z x "$x" ;;
      *)                lf -remote "send $id echoerr 'Unknown format: ${x##*/}'" ;;
    esac
  done
  lf -remote 'send reload'
}}

#: Create tar.gz (simple)
cmd tar ${{
  set -f
  printf "Archive name: "
  read -r name
  [ -z "$name" ] && exit 1
  tar -czf "${name}.tar.gz" $fx && \
    notify-send "Archive created" "${name}.tar.gz" 2>/dev/null
  lf -remote 'send reload'
}}

#: Create zip (simple)
cmd zip-files ${{
  set -f
  printf "Archive name: "
  read -r name
  [ -z "$name" ] && exit 1
  zip -r -q "${name}.zip" $fx && \
    notify-send "Archive created" "${name}.zip" 2>/dev/null
  lf -remote 'send reload'
}}

#: }}}

#: === FILE CREATION & MANAGEMENT === {{{

#: Create new file
cmd touch-file ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  printf "File name: "
  read name
  touch "$name"
  clear
}}

#: Create new directory
cmd mkdir ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "%s\n\t" "$fx"
  printf "Folder name: "
  read newd
  mkdir -- "$newd"
}}

#: }}}

#: === SEARCH & NAVIGATION === {{{

#: Jump to location with fzf
cmd fzf_jump ${{
  res="$(find . 2>/dev/null -maxdepth 6 | fzf --bind tab:down,shift-tab:up --reverse --header='Jump to location')"
  if [ -f "$res" ]; then
    cmd="select"
  elif [ -d "$res" ]; then
    cmd="cd"
  fi
  lf -remote "send $id $cmd \"$res\""
}}

#: }}}

#: === PERMISSIONS === {{{

#: Change file permissions
cmd chmod ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "%s\n\t" "$fx"
  printf "chmod: "
  read ans

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    chmod "$ans" "$file"
  done <<EOF
$fx
EOF

  lf -remote 'send reload'
  lf -remote 'send clear'
}}

#: Change file owner
cmd chown ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "%s\n\t" "$fx"
  printf "chown: "
  read ans

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    sudo chown "$ans" "$file"
  done <<EOF
$fx
EOF

  lf -remote 'send reload'
  lf -remote 'send clear'
}}

#: }}}

#: === FILE INFORMATION === {{{

#: Show file MIME type
cmd file-type ${{
  file -i "$f" ; read a
  clear
}}

#: Bulk rename files
cmd bulk-rename ${{
  old="$(mktemp)"
  new="$(mktemp)"
  if [ -n "$fs" ]; then
    fs="$(basename -a $fs)"
  else
    fs="$(ls)"
  fi
  printf '%s\n' "$fs" >"$old"
  printf '%s\n' "$fs" >"$new"
  $EDITOR "$new"
  [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
  paste "$old" "$new" | while IFS= read -r names; do
  src="$(printf '%s' "$names" | cut -f1)"
  dst="$(printf '%s' "$names" | cut -f2)"
  if [ "$src" = "$dst" ] || [ -e "$dst" ]; then
    continue
  fi
  mv -- "$src" "$dst"
  done
  rm -- "$old" "$new"
  lf -remote "send $id unselect"
}}

#: }}}

#: === SYSTEM OPERATIONS === {{{

#: Stop lf (suspend)
cmd stop ${{
  kill -TSTP "$(ps -p $$ -o 'ppid=')"
}}

#: Unmount USB devices
cmd ud-unmount ${{
    if udiskie-umount -aef; then
        lf -remote "send $id echomsg >> The device was umounted <<"
    else
        lf -remote "send $id echoerr >> udiskie-umount failed <<"
    fi
}}

#: Set background image
cmd setbg ${{
  case "$(file --mime-type -Lb "$f")" in
    image/*)  setsid -f setbg "$f" >/dev/null 2>&1 ;;
    *)        lf -remote "send $id echoerr 'not an image'" ;;
  esac
}}

#: Select files by glob pattern
cmd select-glob &{{
    select_glob() {
        files="$(printf '%s\0' "$@" | sed 's/ /\\ /g;s/\x00/ /g')"
        lf -remote "send $id :unselect; toggle $files"
    }

    [ "$#" -eq 1 ] || exit

    # enable recursive glob and failglob
    shopt -s globstar failglob

    select_glob $1
}}

