#: === CACHE & RELOAD COMMANDS === {{{

#: Hard reload (clear cache)
cmd hard-reload &{{
  if [ -d "$HOME/.cache/lf" ]; then
    find "$HOME/.cache/lf" -mindepth 1 -delete 2>/dev/null
    rmdir -- "$HOME/.cache/lf" 2>/dev/null || true
  fi
  lf -remote "send $id reload"
}}

#: Cancel ongoing file transfer
cmd cancel-transfer &{{
  pid_file="$HOME/.cache/lf/transfer.pid"
  if [ ! -f "$pid_file" ]; then
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  pid=$(cat "$pid_file" 2>/dev/null)
  if [ -z "$pid" ]; then
    rm -f -- "$pid_file"
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f -- "$pid_file"
    lf -remote "send $id :redraw; reload; clear"
    exit 0
  fi

  kill -TERM "$pid" 2>/dev/null
  sleep 0.3
  kill -KILL "$pid" 2>/dev/null || true

  rm -f -- "$pid_file"

  notify-send -u critical -i process-stop "Transfer cancelled" \
    "Operation was cancelled by user. Partial files may remain at destination." \
    2>/dev/null
  lf -remote "send $id echoerr 'transfer: cancelled by user'"
  lf -remote "send $id reload"
}}

