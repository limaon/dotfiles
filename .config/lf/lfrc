#: === NAVIGATION COMMANDS === {{{

#: Return to the previous directory
cmd previous-directory push "''"

#: Jump to directory with fzf
cmd changedirectory ${{
  set -f
  MBASE="/run/media/$(id -un)"
  clear

  dirpath="$(
    {
      find "$HOME" -maxdepth 4 -type d 2>/dev/null
      find "$MBASE" -mindepth 1 -maxdepth 1 -type d \
        -exec mountpoint -q -- {} \; -print 2>/dev/null
    } |
      while IFS= read -r path; do
        if [[ "$path" == "$HOME" ]]; then
          printf '~/\n'
        elif [[ "$path" == "$HOME/"* ]]; then
          printf '~/%s\n' "${path#"$HOME/"}"
        else
          printf '%s\n' "$path"
        fi
      done |
      fzf --layout=reverse --height 40% --prompt 'Go to where? '
  )"

  case "$dirpath" in
    '~'|'~/') dirpath="$HOME" ;;
    '~/'*) dirpath="$HOME/${dirpath#\~/}" ;;
  esac

  [[ -n "$dirpath" ]] && lf -remote "send $id cd \"$dirpath\""
}}

#: Jump to current playing song in MPD
cmd go_to_current_song ${{
	music_dir=$( grep -Po 'music_directory\s*"\K.*(?="$)' ~/.config/mpd/mpd.conf )
	playing_file=$( mpc -f %file% | head -1 )
	lf -remote " send $id select '${music_dir}/${playing_file}' "
}}

