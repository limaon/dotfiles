#: === ARCHIVE OPERATIONS === {{{

#: Extract archives (simple)
cmd extract ${{
  set -f
  for x in $fx; do
    case "$x" in
      *.tar.gz|*.tgz)   tar -xzf "$x" ;;
      *.tar.bz2|*.tbz2) tar -xjf "$x" ;;
      *.tar.xz|*.txz)   tar -xJf "$x" ;;
      *.tar)            tar -xf "$x" ;;
      *.zip)            unzip -q "$x" ;;
      *.rar)            urar x "$x" ;;
      *.7z)             7z x "$x" ;;
      *)                lf -remote "send $id echoerr 'Unknown format: ${x##*/}'" ;;
    esac
  done
  lf -remote 'send reload'
}}

#: Create tar.gz (simple)
cmd tar ${{
  set -f
  printf "Archive name: "
  read -r name
  [ -z "$name" ] && exit 1
  tar -czf "${name}.tar.gz" $fx && \
    notify-send -i archive "Archive created" "${name}.tar.gz" 2>/dev/null
  lf -remote 'send reload'
}}

#: Create zip (simple)
cmd zip-files ${{
  set -f
  printf "Archive name: "
  read -r name
  [ -z "$name" ] && exit 1
  zip -r -q "${name}.zip" $fx && \
    notify-send -i archive "Archive created" "${name}.zip" 2>/dev/null
  lf -remote 'send reload'
}}

