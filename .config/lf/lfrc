#: === PERMISSIONS === {{{

#: Change file permissions
cmd chmod ${{
  clear
  set -f
  while IFS= read -r file; do
    [ -n "$file" ] && printf "%s\n" "${file##*/}"
  done <<< "$fx"
  printf "chmod: "
  read ans

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    chmod "$ans" "$file"
  done <<EOF
$fx
EOF

  lf -remote 'send reload'
  lf -remote 'send clear'
}}

#: Change file owner
cmd chown ${{
  clear
  set -f
  while IFS= read -r file; do
    [ -n "$file" ] && printf "%s\n" "${file##*/}"
  done <<< "$fx"
  printf "chown: "
  read ans

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    sudo chown "$ans" "$file"
  done <<EOF
$fx
EOF

  lf -remote 'send reload'
  lf -remote 'send clear'
}}

