#: === FILE TRANSFER OPERATIONS === {{{

#: Paste files (copy or move)
cmd paste ${{
  FILES_DB="$HOME/.local/share/lf/files"
  [ -f "$FILES_DB" ] || exit 1

  mode="$(head -n 1 -- "$FILES_DB")"
  mapfile -t items < <(tail -n +2 -- "$FILES_DB")
  [ "${#items[@]}" -gt 0 ] || exit 0

  case "$mode" in
    copy)
      rsync -av --progress -- "${items[@]}" . && \
        notify-send -i edit-copy "Copied" "$(printf '%s\n' "${items[@]}" | wc -l) file(s)" 2>/dev/null
      ;;
    move)
      rsync -av --progress --remove-source-files -- "${items[@]}" . && \
        notify-send -i edit-cut "Moved" "$(printf '%s\n' "${items[@]}" | wc -l) file(s)" 2>/dev/null
      ;;
  esac

  rm -f -- "$FILES_DB"
  lf -remote 'send reload'
}}

#: Copy to destination
cmd copyto ${{
  set -f
  clear
  mount_root="/run/media/$(id -un)"
  dest="$(
    {
      find "$HOME" -maxdepth 4 -type d 2>/dev/null
      find "$mount_root" -mindepth 1 -maxdepth 1 -type d \
        -exec mountpoint -q -- {} \; -print 2>/dev/null
    } |
      while IFS= read -r path; do
        if [[ "$path" == "$HOME" ]]; then
          printf '~/\n'
        elif [[ "$path" == "$HOME/"* ]]; then
          printf '~/%s\n' "${path#"$HOME/"}"
        else
          printf '%s\n' "$path"
        fi
      done |
      fzf --prompt 'Copy to: '
  )"

  display_dest="$dest"

  case "$dest" in
    '~'|'~/') dest="$HOME" ;;
    '~/'*) dest="$HOME/${dest#\~/}" ;;
  esac

  [ -d "$dest" ] || exit 1
  rsync -av --progress -- $fx "$dest" 2>/dev/null && \
    notify-send -i edit-copy "Copied" "to $display_dest" 2>/dev/null
  lf -remote 'send reload'
}}

#: Move to destination
cmd moveto ${{
  set -f
  clear
  mount_root="/run/media/$(id -un)"
  dest="$(
    {
      find "$HOME" -maxdepth 4 -type d 2>/dev/null
      find "$mount_root" -mindepth 1 -maxdepth 1 -type d \
        -exec mountpoint -q -- {} \; -print 2>/dev/null
    } |
      while IFS= read -r path; do
        if [[ "$path" == "$HOME" ]]; then
          printf '~/\n'
        elif [[ "$path" == "$HOME/"* ]]; then
          printf '~/%s\n' "${path#"$HOME/"}"
        else
          printf '%s\n' "$path"
        fi
      done |
      fzf --prompt 'Move to: '
  )"

  display_dest="$dest"

  case "$dest" in
    '~'|'~/') dest="$HOME" ;;
    '~/'*) dest="$HOME/${dest#\~/}" ;;
  esac

  [ -d "$dest" ] || exit 1
  rsync -av --progress --remove-source-files -- $fx "$dest" 2>/dev/null && \
    notify-send -i edit-cut "Moved" "to $display_dest" 2>/dev/null
  lf -remote 'send reload'
}}

