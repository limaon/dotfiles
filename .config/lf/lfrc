#: === FILE CREATION & MANAGEMENT === {{{

#: Create new file
cmd touch-file ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  printf "File name: "
  read name
  touch "$name"
  clear
}}

#: Create new directory
cmd mkdir ${{
  clear; tput cup $(($(tput lines)/3)); tput bold
  set -f
  printf "%s\n\t" "$fx"
  printf "Folder name: "
  read newd
  mkdir -- "$newd"
}}

