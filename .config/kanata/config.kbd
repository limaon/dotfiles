;; vim: ft=lisp

;; Kanata Configuration - Home Row Mods with Same-Hand Blocking
;; Created: 2025-01-11
;; Layout: US QWERTY with Home Row Mods (GACS order)
;;
;; Key Remaps:
;; ESC/Caps Lock are swapped
;;
;; Home Row Mods with Same-Hand Blocking:
;; A/S/D/F: LGUI/LALT/LCTL/LSFT (left hand)
;; J/K/L/;;: RSFT/RCTL/RALT/RGUI (right hand)
;;
;; Feature: When holding a Home Row Mod key, keys on the SAME side are BLOCKED
;; This forces you to use the opposite hand, distributing typing load
;;
;; Implementation: Uses layer-while-held with XX (no-op) to block same-side keys

(defcfg
  ;; Process keys not in defsrc
  process-unmapped-keys yes

  ;; Enable layer change logging
  log-layer-changes yes

  ;; X11 repeat rate: delay=300ms, rate=50 repeats/sec
  linux-x11-repeat-delay-rate 300,50
)

;; Home Row Mods with TRUE Same-Hand Blocking
;; Uses multi to activate modifier + layer that blocks same-side keys
(defalias
  ;; LEFT HAND: Tap for letter, hold for modifier + block left side
  a-mod (tap-hold 200 200 a (multi lmet (layer-while-held left-blocked)))
  s-mod (tap-hold 200 200 s (multi lalt (layer-while-held left-blocked)))
  d-mod (tap-hold 200 200 d (multi lctl (layer-while-held left-blocked)))
  f-mod (tap-hold 200 200 f (multi lsft (layer-while-held left-blocked)))

  ;; RIGHT HAND: Tap for letter, hold for modifier + block right side
  j-mod (tap-hold 200 200 j (multi rsft (layer-while-held right-blocked)))
  k-mod (tap-hold 200 200 k (multi rctl (layer-while-held right-blocked)))
  l-mod (tap-hold 200 200 l (multi ralt (layer-while-held right-blocked)))
  sc-mod (tap-hold 200 200 ; (multi rmet (layer-while-held right-blocked)))

  ;; Layer toggle: RSFT switches between plain (default) and hrm
  lyr-hrm   (layer-switch hrm)
  lyr-plain (layer-switch plain)

  ;; RSFT: tap to toggle Home Row Mods, hold for normal shift
  rsft-hrm-toggle (tap-hold 200 200 @lyr-hrm rsft)
  rsft-plain-toggle (tap-hold 200 200 @lyr-plain rsft)
)

;; Physical keyboard layout (US QWERTY)
(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt spc  ralt rmet rctl
  ins
)

;; Default layer without Home Row Mods
(deflayer plain
  caps 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    @rsft-hrm-toggle
  lctl lmet lalt spc  ralt rmet rctl
  ins
)

;; Home Row Mods layer (RSFT to toggle back to plain)
(deflayer hrm
  caps 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  @a-mod @s-mod @d-mod @f-mod  g    h    @j-mod @k-mod @l-mod @sc-mod '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    @rsft-plain-toggle
  lctl lmet lalt spc  ralt rmet rctl
  ins
)

;; Layer activated when holding LEFT hand Home Row Mod
;; Blocks LEFT side letter keys (XX = no-op), but allows Home Row Mods (_)
;; RIGHT side passes through (_)
(deflayer left-blocked
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    XX   XX   XX   XX   XX   _    _    _    _    _    _    _    _
  _    lmet lalt lctl lsft XX   _    _    _    _    _    _    _
  _    XX   XX   XX   XX   XX   _    _    _    _    _    _
  _    _    _    _    _    _    _
  _
)

;; Layer activated when holding RIGHT hand Home Row Mod
;; Blocks RIGHT side letter keys (XX = no-op), but allows Home Row Mods (_)
;; LEFT side passes through (_)
(deflayer right-blocked
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    XX   XX   XX   XX   XX   _    _    _
  _    _    _    _    _    _    XX   rsft rctl ralt rmet _    _
  _    _    _    _    _    _    XX   XX   XX   XX   XX   _
  _    _    _    _    _    _    _
  _
)
