#!/usr/bin/env bash

set -euo pipefail

# Credits:
# This script is based on, and inspired by, 'BreadOnPenguins' dmenu_cliphist:
# https://github.com/BreadOnPenguins/scripts/blob/master/dmenu_cliphist

HISTFILE="/tmp/cliphist"
PLACEHOLDER=$'\x01NEWLINE\x01'

# Dependency checks
check_dependencies() {
  local missing=()
  command -v xclip >/dev/null 2>&1 || missing+=("xclip")
  if [ "${1:-}" = "sel" ]; then
    command -v dmenu >/dev/null 2>&1 || missing+=("dmenu")
  fi
  command -v flock >/dev/null 2>&1 || missing+=("flock")

  if [ ${#missing[@]} -gt 0 ]; then
    printf "Error: Missing required dependencies: %s\n" "${missing[*]}" >&2
    exit 1
  fi

  # Check for notify-send availability
  if command -v notify-send >/dev/null 2>&1; then
    HAS_NOTIFY_SEND=1
  else
    HAS_NOTIFY_SEND=0
  fi
}

# Get reverse command (tac for Linux, tail -r for BSD/macOS)
get_reverse_cmd() {
  if command -v tac >/dev/null 2>&1; then
    printf "tac"
  else
    printf "tail -r"
  fi
}

# Create the history file if needed
ensure_histfile() {
  if [ ! -f "$HISTFILE" ]; then
    mkdir -p "$(dirname "$HISTFILE")"
    touch "$HISTFILE"
  fi
}

# Replace newlines with PLACEHOLDER
escape_newlines() {
  local input="$1"
  printf '%s' "${input//$'\n'/$PLACEHOLDER}"
}

# Replace PLACEHOLDER with newlines
unescape_newlines() {
  local input="$1"
  printf '%s' "${input//$PLACEHOLDER/$'\n'}"
}

read_clipboard() {
  local clip
  clip=$(xclip -o -selection clipboard 2>/dev/null && printf '\001') || {
    printf "Error: Failed to read text from clipboard\n" >&2
    exit 1
  }
  clip=${clip%$'\001'}
  printf '%s' "$clip"
}

output() {
  local clip
  clip=$(cat && printf '\001') || {
    printf "Error: Failed to read from stdin\n" >&2
    exit 1
  }
  clip=${clip%$'\001'}
  printf '%s' "$clip" | xclip -i -selection clipboard 2>/dev/null || {
    printf "Error: Failed to write to clipboard\n" >&2
    exit 1
  }
  printf '%s' "$clip"
}

write() {
  local clip="$1"
  local multiline

  [ -z "$clip" ] && return 0

  ensure_histfile || return
  multiline=$(escape_newlines "$clip")

  (
    flock -x 9 || exit
    if grep -Fxq -- "$multiline" "$HISTFILE"; then
      :
    else
      status=$?
      if [ "$status" -ne 1 ]; then
        printf "Error: Failed to read history file\n" >&2
        exit "$status"
      fi
      printf '%s\n' "$multiline" >> "$HISTFILE" || exit
    fi
  ) 9>>"$HISTFILE" || return

  printf '%s' "$clip"
}

sel() {
  local reverse_cmd
  local selection
  local restored
  local history entry i
  local -a entries=() labels=()

  reverse_cmd=$(get_reverse_cmd)
  history=$($reverse_cmd "$HISTFILE") || return
  [ -n "$history" ] || return 0
  mapfile -t entries <<< "$history"
  for i in "${!entries[@]}"; do
    entry=${entries[$i]//$PLACEHOLDER/ }
    labels+=("$((i + 1)): $entry")
  done

  selection=$(printf '%s\n' "${labels[@]}" | dmenu -i -l 5 -p "Clipboard history:") || {
    printf "Error: Failed to open dmenu\n" >&2
    exit 1
  }

  if [ -n "$selection" ]; then
    entry=$selection
    for i in "${!labels[@]}"; do
      if [ "$selection" = "${labels[$i]}" ]; then
        entry=${entries[$i]}
        break
      fi
    done
    restored=$(unescape_newlines "$entry" && printf '\001')
    restored=${restored%$'\001'}
    printf '%s' "$restored" | xclip -i -selection clipboard 2>/dev/null || {
      printf "Error: Failed to write to clipboard\n" >&2
      exit 1
    }
  fi
}

# Main
check_dependencies "${1:-}"

case "${1:-}" in
  add)
    clip=$(read_clipboard && printf '\001')
    clip=${clip%$'\001'}
    write "$clip" >/dev/null
    notification="Copied to clipboard"
    ;;
  out)
    clip=$(output && printf '\001')
    clip=${clip%$'\001'}
    notification=$(write "$clip")
    ;;
  sel)
    notification=$(sel)
    ;;
  *)
    printf "%s | File: %s\n\nadd - adds current clipboard text to history file\nout - pipe commands to copy output to clipboard, and add to history file\nsel - select from history file with dmenu and recopy!\n" "$0" "$HISTFILE"
    exit 0
    ;;
esac

if [ -n "$notification" ] && [ "$HAS_NOTIFY_SEND" -eq 1 ]; then
  notify-send -- "$notification" || true
fi
